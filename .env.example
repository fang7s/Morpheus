# ─── Morpheus EVM LP Agent — environment template ────────────────────
# Copy this file to `.env` and fill in the values you need:
#   Copy-Item .env.example .env
#
# NEVER commit `.env`. It is gitignored because it can contain a private key.
# Empty RPC variables fall back to the built-in public presets in config.js.

# ─── 1. Default chain & execution mode ───────────────────────────────
# Default chain for positions that do not set their own chain/chainId.
# Supported: arbitrum | base | ethereum | bnb | robinhood
# Aliases:   arb | eth | mainnet | bsc | binance | orbit | robinhood-chain
CHAIN=arbitrum

# Shadow mode is ON by default and never broadcasts a transaction.
# Live trading requires ALL THREE:
#   DRY_RUN=false
#   I_UNDERSTAND_LIVE_TRADING=true
#   WALLET_PRIVATE_KEY=<0x...>
DRY_RUN=true
I_UNDERSTAND_LIVE_TRADING=false

# Alias for DRY_RUN. Keep both in sync when toggling; if they disagree,
# DRY_RUN takes precedence and a startup warning is logged.
SHADOW_MODE=true

# ─── 2. Multi-chain RPC auto-routing ─────────────────────────────────
# Configure any or all chains at once. Each LP position is routed to the
# RPCs of its own chain (set `chain` or `chainId` in user-config.json).
#
# *_RPC_URL   single endpoint, highest priority for that chain
# *_RPC_URLS  comma-separated fallback list; the first URL is primary and
#             the rest are used by ethers FallbackProvider (quorum: 1)
#
# Empty values fall back to the chain's built-in public RPC presets.

# Ethereum Mainnet
ETH_RPC_URL=
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
ETH_RPC_URLS=
# ETH_RPC_URLS=https://ethereum-rpc.publicnode.com,https://eth.llamarpc.com

# BNB Smart Chain (BSC). BNB_RPC_URL / BNB_RPC_URLS are accepted aliases.
BSC_RPC_URL=
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
BSC_RPC_URLS=
# BSC_RPC_URLS=https://bsc-rpc.publicnode.com,https://bsc-dataseed.binance.org

# Base
BASE_RPC_URL=
# BASE_RPC_URL=https://mainnet.base.org
BASE_RPC_URLS=
# BASE_RPC_URLS=https://mainnet.base.org,https://base-rpc.publicnode.com

# Robinhood Chain (Arbitrum Orbit).
# RHC_RPC_URL / RHC_RPC_URLS are accepted aliases.
ROBINHOOD_RPC_URL=
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_URLS=
# ROBINHOOD_RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-rpc.publicnode.com

# Arbitrum One
ARBITRUM_RPC_URL=
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_RPC_URLS=
# ARBITRUM_RPC_URLS=https://arb1.arbitrum.io/rpc,https://arbitrum-rpc.publicnode.com

# Optional global override for the default CHAIN only (highest priority).
RPC_URL=

# ─── 3. Optional provider, explorer & data-service keys ──────────────
# Morpheus does not build provider URLs from these keys. If your RPC endpoint
# needs a key, put the full URL in the matching *_RPC_URL(S) variable above,
# for example: ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/<KEY>
ALCHEMY_API_KEY=
INFURA_API_KEY=
QUICKNODE_API_KEY=

# Optional explorer key for block-explorer verification tooling.
# Not required for the LP manager runtime.
ETHERSCAN_API_KEY=

# Optional data-service credentials. The public GeckoTerminal and DexScreener
# endpoints work without keys; these are reserved for rate-limit bypass setups.
DEXSCREENER_API_KEY=
GECKOTERMINAL_API_KEY=

# ─── 3b. Pool indexer / subgraph fallback (fee tiers) ────────────────
# Secondary source for exact Uniswap v3 pool metadata when DexScreener or
# GeckoTerminal return `fee n/a` (common on newer EVM chains such as
# Robinhood Chain 4663). The /pool pipeline is:
#   DexScreener/Gecko -> indexer/subgraph -> on-chain fee() RPC
#
# INDEXER_API_URL is a generic endpoint. Prefer a chain-scoped URL so a single
# chain's subgraph is queried deterministically (SUBGRAPH_URL_<chainId>), e.g.
# SUBGRAPH_URL_4663=https://api.studio.thegraph.com/query/<id>/<subgraph>/version/latest
# Generic endpoint fallback:
INDEXER_API_URL=
# Chain-scoped subgraphs (highest priority for that chain):
SUBGRAPH_URL_4663=
SUBGRAPH_URL_8453=
SUBGRAPH_URL_42161=
SUBGRAPH_URL_1=
SUBGRAPH_URL_56=
# auto | graphql | subgraph | envio | defined | rest
INDEXER_API_TYPE=auto
# Optional bearer/x-api-key for hosted indexers (The Graph, Defined.fi, Envio).
INDEXER_API_KEY=
# Chain hint for a generic INDEXER_API_URL: chain key or numeric chain id.
INDEXER_CHAIN=
# Optional request timeout in milliseconds.
INDEXER_TIMEOUT_MS=8000
# Set to false to skip the indexer entirely and use on-chain fee() only.
INDEXER_ENABLED=true

# Per-chain aliases (alternative to SUBGRAPH_URL_<chainId>):
# ROBINHOOD_SUBGRAPH_URL=   RHC_INDEXER_URL=
# BASE_SUBGRAPH_URL=        ETH_SUBGRAPH_URL=
# BSC_SUBGRAPH_URL=         ARBITRUM_SUBGRAPH_URL=

# ─── 4. Wallet & live-trading security ───────────────────────────────
# ⚠️  DANGER: anyone with this key controls the wallet.
# - Use a dedicated hot wallet with limited funds, never your main wallet.
# - Never paste this key into source code, screenshots, chats, or commits.
# - `.env` is gitignored; keep it readable only by the runtime user.
# Required only when DRY_RUN=false and I_UNDERSTAND_LIVE_TRADING=true.
WALLET_PRIVATE_KEY=
# Legacy alias accepted for backwards compatibility:
# PRIVATE_KEY=

# Wallet LP auto-discovery is ON by default. If no explicit positions are
# configured, Morpheus scans every configured chain for positions owned by the
# discovery wallet (or the address derived from WALLET_PRIVATE_KEY).
DISCOVERY_ENABLED=true
# Optional watch-only address. Leave empty to derive from WALLET_PRIVATE_KEY.
DISCOVERY_WALLET=
DISCOVERY_MAX_POSITIONS=10

# ─── 5. Runtime & logging ────────────────────────────────────────────
# Polling cadence for the Evil Panda exit engine.
POLL_INTERVAL_MS=15000

# debug | info | warn | error
LOG_LEVEL=info

# ─── 6. Local health-check server ────────────────────────────────────
# Binds to 127.0.0.1 only. GET /health and GET /positions.
HEALTH_ENABLED=false
PORT=3010
# HEALTH_PORT is a legacy alias for PORT.
# HEALTH_PORT=3010

# ─── 7. Telegram notifications & command menu ────────────────────────
# TELEGRAM_ENABLED gates exit/alert notifications only.
TELEGRAM_ENABLED=true

# The interactive command menu starts whenever the token and chat ID below are
# set. Set this to false to disable commands while keeping alert credentials.
TELEGRAM_COMMANDS_ENABLED=true

# ─── 7b. User-triggered /deploy guardrails ───────────────────────────
# The bot never scans or buys passively. `/deploy <token_address>` only runs
# when you send it from the authorized chat.
#
# Abort when the estimated transaction fee exceeds this USD amount.
MAX_GAS_FEE_USD=0.50
# Abort when GoPlus reports a buy or sell tax above this percentage.
DEPLOY_MAX_TAX_PCT=1
# USD budget allocated to the selected side (dual splits it 50:50).
DEPLOY_AMOUNT_USD=100
# Minimum acceptable estimated deposit.
DEPLOY_MIN_AMOUNT_USD=1
DEPLOY_SLIPPAGE_BPS=100
DEPLOY_DEADLINE_SEC=1200
# Fallback gas units when estimateGas cannot simulate the mint pre-approval.
DEPLOY_GAS_LIMIT_ESTIMATE=450000
DEPLOY_APPROVE_GAS_LIMIT_ESTIMATE=60000
# Optional manual native-token USD price. Leave empty for DexScreener pricing.
NATIVE_USD_PRICE=
# Fail closed when GoPlus has no safety data. Only set true for chains/tokens
# you have verified yourself.
DEPLOY_ALLOW_UNVERIFIED=false
# Optional override for the automation store (defaults to ./active-automations.json).
ACTIVE_AUTOMATIONS_PATH=

# Commands are accepted ONLY from this exact chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
