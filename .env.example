# ─── Morpheus EVM (Uniswap v3 / PancakeSwap v3) ──────────────────────
# Copy to .env and fill in. NEVER commit .env.

# Default chain for positions that do not specify chain/chainId.
# arbitrum | base | ethereum | bnb | robinhood
# aliases: eth, mainnet, bsc, binance, orbit
CHAIN=arbitrum

# ─── Multi-chain RPC auto-routing ────────────────────────────────────
# Configure any or all chains at the same time. Each LP position is routed to
# the RPCs of its own chain. Use _RPC_URL for one endpoint and _RPC_URLS for a
# comma-separated fallback list (ethers FallbackProvider, quorum 1).
ETH_RPC_URL=
ETH_RPC_URLS=
BSC_RPC_URL=
BSC_RPC_URLS=
BASE_RPC_URL=
BASE_RPC_URLS=
ROBINHOOD_RPC_URL=
ROBINHOOD_RPC_URLS=
ARBITRUM_RPC_URL=
ARBITRUM_RPC_URLS=

# Optional extra override for the default CHAIN only (highest priority).
RPC_URL=

# Required only for LIVE trading. Leave empty for shadow/dry-run mode.
# Use a dedicated hot wallet with limited funds.
PRIVATE_KEY=

# Shadow mode is ON by default. Live trading requires BOTH:
#   DRY_RUN=false
#   I_UNDERSTAND_LIVE_TRADING=true
DRY_RUN=true
I_UNDERSTAND_LIVE_TRADING=false

# Poll cadence for the Evil Panda exit engine
POLL_INTERVAL_MS=15000

# Optional health endpoint
HEALTH_ENABLED=false
HEALTH_PORT=3010

# Optional Telegram alerts (Bot API is called via fetch, no extra package)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional log level: debug | info | warn | error
LOG_LEVEL=info
